{
  "name": "css",
  "version": "2.0.0",
  "description": "Modern CSS build tools without Gulp",
  "main": "index.js",
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "bootstrap": "^5.3.3",
    "bulma": "^1.0.2",
    "clean-css-cli": "^5.6.3",
    "ejs": "^3.1.10",
    "jquery": "^3.7.1",
    "less": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0",
    "chokidar-cli": "^3.0.0"
  },
  "scripts": {
    "start": "npm-run-all --parallel watch:*",
    "build": "npm-run-all --parallel build:*",
    "build:less": "lessc less/css/top.less less/css/top.css",
    "build:sass": "sass --style=compressed bulma/sass/main.sass bulma/css/main.css",
    "build:ejs": "node scripts/build-ejs.js",
    "build:custom": "npm-run-all css-compile css-prefix css-minify",
    "watch:less": "chokidar 'less/css/top.less' -c 'npm run build:less'",
    "watch:sass": "chokidar 'bulma/sass/**/*.sass' -c 'npm run build:sass'",
    "watch:ejs": "chokidar 'ejssample/src/ejs/**/*.ejs' -c 'npm run build:ejs'",
    "css-compile": "sass --style=expanded --source-map --embed-sources src/custom.scss dist/css/custom.css",
    "css-prefix": "postcss --config postcss.config.js --replace dist/css/*.css",
    "css-minify": "cleancss --level 1 --source-map --source-map-inline-sources --output dist/css/custom.min.css dist/css/custom.css",
    "test": "echo \"No tests specified\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://umanari145@github.com/umanari145/css.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/umanari145/css/issues"
  },
  "homepage": "https://github.com/umanari145/css#readme"
}
